# Kindi configuration - copy to ~/.kindi/kindi.conf (or ./kindi.conf, or point KINDI_CONFIG / --config at it).
# Every key is optional; these are the defaults. Environment variables KINDI_<KEY> and command-line flags win over
# this file. See docs/CONFIGURATION.md, and docs/CONFIGURATION-REFERENCE.md for the generated list of
# every key and every KINDI_* environment variable.

[kindi]
# --- where things live
pack = ~/.kindi/pack
state_dir = ~/.kindi/state

# --- server
host = 127.0.0.1
port = 8093
# api_key = choose-a-long-random-string
model_name = auto

# --- engine
ctx = 24576
head = exact
fast_clusters = 256
# 1: stop a reply caught in a repeating loop (close it while thinking)
repeat_stop = 0

# --- prompt cache
checkpoint_every = 256
prefix_max = 8
prefix_min = 512
park_max = 3
# host RAM for checkpoints and parked conversations (0: 20% of the RAM)
checkpoint_budget_mb = 0

# --- Nanbeige drafting
# prompt-lookup drafting, up to this many tokens per check (0: off)
lookup = 5
# a second draft source; empty: none
mtp_head =
# 27B template: xhigh, medium or low (empty: the template default, xhigh)
reasoning_effort =

# --- generation defaults (a request's own values win)
max_tokens = 1024
temperature = 0.7
top_p = 0.8
top_k = 20
min_p = 0
repeat_penalty = 1.0
repeat_last_n = 64
# OpenAI's additive presence penalty, -2..2 (0: off); the Bonsai backends apply it (Gemma 4 and Nanbeige do not)
presence_penalty = 0
# default: the values above; publisher: the Bonsai publisher's profile (non-thinking 0.7 / 0.8 / 20 with presence
# 1.5; thinking 1.0 / 0.95 / 20 with presence 1.0 and up to 8K output). Values set explicitly above always win.
sampling_profile = default
