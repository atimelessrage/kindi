kindi/COMMIT export-subst
* text=auto
# The install scripts are published byte for byte (the site and the release notes carry their sha256), so they are
# checked out with LF on every OS, also with core.autocrlf=true.
*.ps1 text eol=lf
*.sh text eol=lf
# kindi/gemma4_cache.py predates the LF normalization: keeping its bytes stable means a logic change shows
# as a logic diff instead of a whole-file line-ending rewrite.
kindi/gemma4_cache.py -text
